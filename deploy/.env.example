# Docker 部署环境变量；数据库、Redis、JWT 和会话配置统一从 Nacos 读取。
# 真实 .env 仅保存在部署主机，不要提交到 Git 仓库。

# 应用启动参数。
NODE_ENV=production
PORT=5050

# Nacos 连接、鉴权和配置订阅参数。
NACOS_SERVER=10.66.0.1:8848
NACOS_SERVICE_NAME=chat-web-auth-service
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-auth-service.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-nacos-password

# 业务容器接入的外部 Docker 网络；与其他微服务保持一致。
DOCKER_NETWORK=chat-web-infrastructure
