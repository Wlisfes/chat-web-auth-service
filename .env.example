# Node.js 运行环境；本地开发使用 development。
NODE_ENV=development
# 本地服务监听端口；Docker 部署端口由 Compose 的容器端口决定。
PORT=5050

# Nacos 服务地址，格式为 host:port。
NACOS_SERVER=127.0.0.1:8848
# Nacos 服务名称。
NACOS_SERVICE_NAME=chat-web-auth-service
# Nacos 命名空间 ID（不是命名空间显示名称）。
NACOS_NAMESPACE=replace-with-nacos-namespace-id
# Nacos 配置中心 Data ID；配置分组默认使用 DEFAULT_GROUP。
NACOS_CONFIG_DATA_ID=chat-web-auth-service.yaml
# Nacos 鉴权用户名。
NACOS_USERNAME=nacos
# Nacos 鉴权密码。
NACOS_PASSWORD=replace-with-nacos-password
